# Mac-local secrets for activate-agent.sh (variant A, step 3).
# Copy to ~/.turnip/publish.env and fill in — these must MATCH the VM's
# /srv/etc/secrets.env (same R2 bucket, same FEED_SECRET) so the keys the Mac
# writes are the keys the VM's feed points at. Never commit real values.
#
#   mkdir -p ~/.turnip && cp scripts/publish.env.example ~/.turnip/publish.env
#   chmod 600 ~/.turnip/publish.env    # then edit in the real values
#   brew install rclone                # the uploader

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
FEED_SECRET=

# R2_PUBLIC_BASE_URL is intentionally NOT needed here: the VM builds the public
# episode URLs when it writes the feed (step 4); the Mac only writes objects.
