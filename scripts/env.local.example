# Per-machine config for the Mac-side scripts. The real file is gitignored:
#
#   cp scripts/env.local.example scripts/env.local    # then fill in
#
# VM is the turnip box as an ssh target (user@ip). It is the ORIGIN address
# hidden behind Cloudflare — never commit the real value to this public repo.
# ${VM:-…} keeps an explicitly exported VM= winning over this file.
VM="${VM:-user@vm-ip}"
